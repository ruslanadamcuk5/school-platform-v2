{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/claude-sonnet-5-5",
  "small_model": "opencode/claude-haiku-5-5",
  "permission": {
    "bash": "ask",
    "edit": "ask",
    "webfetch": "allow"
  },
  "mcp": {
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@microsoft/postgres-mcp", "run"],
      "environment": {
        "DATABASE_URL": "postgresql://school_app:CHANGE_ME@localhost:5432/school_platform"
      },
      "enabled": false
    }
  }
}
