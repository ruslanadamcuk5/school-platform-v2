# ==== Основные настройки ====
APP_NAME=Школьник
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHARS

# ==== PostgreSQL ====
# Для локальной разработки: localhost
# Для Alwaysdata: host, имя БД и пользователь выдаются в панели Databases > PostgreSQL
DATABASE_URL=postgresql+asyncpg://school_app:CHANGE_ME@localhost:5432/school_platform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ==== Redis ====
REDIS_URL=redis://localhost:6379/0

# ==== JWT ====
JWT_ALGORITHM=RS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem

# ==== Файлы / S3 ====
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=school-platform
S3_REGION=us-east-1

# ==== AI ====
AI_ENABLED=false
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=deepseek/deepseek-chat
AI_API_KEY=CHANGE_ME
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.3

# ==== Почта / уведомления ====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.by
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# ==== Безопасность ====
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_ENABLED=true
AUDIT_LOG_ENABLED=true
